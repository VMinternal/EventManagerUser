<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EventManagerUser.MainPage"
             Title="List of Events">

    <Grid RowDefinitions="Auto, *" RowSpacing="10" Padding="15">

        <!-- Search box for events by name or date -->
        <SearchBar x:Name="EventSearchBar"
                   Grid.Row="0"
                   Placeholder="Search by name or date..."
                   TextChanged="OnSearchTextChanged" />

        <!-- Event display list -->
        <CollectionView x:Name="EventsCollection"
                        Grid.Row="1">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,6" Padding="14" CornerRadius="12" BackgroundColor="#FFFFFF" BorderColor="#E0E0E0">
                        <VerticalStackLayout Spacing="6">

                            <!-- Event title and Favorite button -->
                            <HorizontalStackLayout HorizontalOptions="Fill" Spacing="10">
                                <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" TextColor="#222" VerticalOptions="Center" HorizontalOptions="StartAndExpand"/>

                                <!-- Favorite button -->
                                <Button Text="🤍" 
                                        Clicked="OnFavoriteClicked"
                                        CommandParameter="{Binding Id}"
                                        BackgroundColor="Transparent"
                                        FontSize="22"
                                        Padding="0"
                                        VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <!-- Detailed information -->
                            <Label Text="{Binding Date, StringFormat='📅 Date: {0}'}" FontSize="14" TextColor="#555"/>
                            <Label Text="{Binding Location, StringFormat='📍 Location: {0}'}" FontSize="14" TextColor="#555"/>
                            <Label Text="{Binding Description}" FontSize="13" TextColor="#777" MaxLines="2"/>

                            <!-- Button to open the details page & view individual sessions -->
                            <Button Text="See Details &amp; Sessions ➡️" 
                                    Clicked="OnViewSessionsClicked"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="#512BD4"
                                    TextColor="White"
                                    FontSize="13"
                                    CornerRadius="8"
                                    Margin="0,8,0,0"/>

                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>